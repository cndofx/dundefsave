    int32 statEquipmentTiers[3];
    LinearColor qualityBeamColorOverride;
} Equipment <read=ReadEquipment>;

string ReadEquipment( Equipment &equipment ) {
    return equipment.equipmentTemplate.value;
}

typedef struct {
    Hero hero <bgcolor=cGreen>;
    uint32 equipCount <bgcolor=cYellow>;
    if ( equipCount > 0 ) {
        Equipment equip[equipCount] <optimize=false, bgcolor=cAqua>;
    }
} HeroAndEquipment <read=ReadHeroAndEquipment>;

string ReadHeroAndEquipment( HeroAndEquipment &hero ) {
    return hero.hero.name.value;
}

typedef struct {
    byte achievements[0x1F4];    
} Achievements;

typedef struct {
    byte coreUnlocks[0x28];
} CoreUnlocks;

typedef struct {
    int32 coreIndex;
    LinearColor color1;
    LinearColor color2;
    LinearColor color3;   
} CoreOptions;

typedef struct {
    FString campaignTag;
    int32 difficultyMask;
} LevelProgress;

typedef struct {
    int32 storedMana;
    int32 highInfoStoredMana[3];
} ItemBoxInfo;

uint64 unk;
Options options;

//FSeek(0x9A0);

uint32 numHeroes <bgcolor=cRed>;
HeroAndEquipment hero[numHeroes] <optimize=false>;
Achievements achievements;
CoreUnlocks coreUnlocks;
CoreOptions coreOptions;
int32 numBeatenLevels;
LevelProgress beatenLevels[numBeatenLevels] <optimize=false>;
int32 numUnlockedLevels;
LevelProgress unlockedLevels[numUnlockedLevels] <optimize=false>;
ItemBoxInfo itemBoxInfo;
int32 numEquipment;
Equipment equip[numEquipment] <optimize=false>;